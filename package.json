{
  "name": "angular-splitfy-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4242",
    "start:dev": "ng serve --port 4242",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:regression": "cypress run --spec \"cypress/e2e/regression/**/*.cy.ts\"",
    "cy:run:smoke": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\"",
    "e2e": "start-server-and-test start:dev http://localhost:4242 cy:run:regression",
    "e2e:smoke": "start-server-and-test start:dev http://localhost:4242 cy:run:smoke"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "lucide-angular": "^0.564.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "cypress": "^15.13.1",
    "jsdom": "^27.1.0",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
