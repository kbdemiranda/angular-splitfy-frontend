{
  "name": "angular-splitfy-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "start:dev": "ng serve --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --config jest.config.ts --coverage",
    "test:watch": "jest --config jest.config.ts --watch",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:regression": "cypress run --spec \"cypress/e2e/regression/**/*.cy.ts\"",
    "cy:run:smoke": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\"",
    "e2e": "start-server-and-test start:dev http://localhost:4200 cy:run:regression",
    "e2e:smoke": "start-server-and-test start:dev http://localhost:4200 cy:run:smoke"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "21.1.4",
    "@angular/compiler": "21.1.4",
    "@angular/core": "21.1.4",
    "@angular/forms": "21.1.4",
    "@angular/platform-browser": "21.1.4",
    "@angular/platform-browser-dynamic": "21.1.4",
    "@angular/router": "21.1.4",
    "lucide-angular": "^0.564.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "21.1.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jest": "^30.0.0",
    "cypress": "^15.13.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.4",
    "jsdom": "^27.1.0",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
